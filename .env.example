# Environment Configuration Template

# ============ BASE RPC ============
# Required: RPC endpoint for Base mainnet
BASE_RPC_URL=https://base.infura.io/v3/YOUR_INFURA_KEY
# Alternative providers:
# - Alchemy: https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# - PublicNode: https://base.publicnode.com
# - Ankr: https://rpc.ankr.com/base

# ============ TELEGRAM ============
# Required: Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Required: Chat ID where alerts will be sent
# Get it by messaging bot and looking at /dev/null updates
TELEGRAM_CHAT_ID=987654321

# Optional: Admin user ID for commands
TELEGRAM_ADMIN_ID=987654321

# ============ API KEYS ============
# Optional: Clanker API (if using direct API instead of on-chain events)
CLANKER_API_KEY=your_clanker_api_key

# Optional: Bankr API (if using direct API instead of on-chain events)
BANKR_API_KEY=your_bankr_api_key

# ============ SCANNER CONFIG ============
# Scan interval in milliseconds (default: 5 minutes)
SCAN_INTERVAL_MS=300000

# Minimum score threshold to trigger alert (0-100, default: 60)
MIN_SCORE_THRESHOLD=60

# Maximum tokens to analyze per scan (prevents memory bloat)
MAX_TOKENS_PER_SCAN=50

# Enable/disable each data source
ENABLE_CLANKER=true
ENABLE_BANKR=true
ENABLE_UNISWAP_EVENTS=true

# ============ DATABASE ============
# Path to SQLite database file
DATABASE_PATH=./data/tokens.db

# Auto-backup database (interval in hours)
DB_BACKUP_INTERVAL_HOURS=24

# ============ LOGGING ============
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log file path (optional; omit for console-only)
LOG_FILE=./logs/bot.log

# Max log file size before rotation (MB)
LOG_MAX_SIZE_MB=10

# ============ PERFORMANCE ============
# RPC request timeout (milliseconds)
RPC_TIMEOUT_MS=5000

# Max concurrent RPC requests
RPC_MAX_CONCURRENT=5

# Exponential backoff: initial delay (ms)
BACKOFF_INITIAL_MS=1000

# Exponential backoff: max delay (ms)
BACKOFF_MAX_MS=60000

# ============ SECURITY ============
# Enable signature verification for Telegram commands (optional)
VERIFY_TELEGRAM_SIGNATURE=false

# Rate limit: max alerts per minute (prevent spam)
ALERT_RATE_LIMIT_PER_MIN=10

# ============ OPTIONAL: 1PASSWORD INTEGRATION ============
# If using 1Password CLI (op) for secrets management:
# OP_CONNECT_HOST=http://localhost:8080
# OP_CONNECT_TOKEN=your_connect_token
