# Base Memecoin Detector Bot Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# Telegram Configuration (Required)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Base RPC URL (Required)
# Use Alchemy, Infura, or other RPC provider
# Example: https://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY
BASE_RPC_URL=

# ============================================================================
# OPTIONAL SETTINGS WITH DEFAULTS
# ============================================================================

# API Endpoints (Optional - has defaults)
# Default: https://api.clanker.world
CLANKER_API_URL=

# Default: https://api.bankr.world
BANKR_API_URL=

# Basescan API Key (Optional but recommended)
# Get free API key at: https://basescan.org/apis
# Enables fetching holder data and token info
# Without this, bot falls back to RPC-based holder estimation
BASESCAN_API_KEY=

# Block Explorer URL (Optional)
# Default: https://basescan.org
BLOCK_EXPLORER_URL=https://basescan.org

# ============================================================================
# SCORING CONFIGURATION
# ============================================================================

# Score threshold for alerts (0-100)
# Default: 65 (only alert on tokens scoring 65+)
# Lower = more alerts, Higher = fewer false positives
SCORING_THRESHOLD=65

# Premium score threshold (0-100)
# Default: 80 (tokens 80+ are premium quality)
PREMIUM_SCORE_THRESHOLD=80

# ============================================================================
# SCAN SETTINGS
# ============================================================================

# How often to scan for new tokens (seconds)
# Default: 300 (5 minutes)
# Reduce for more frequent scanning, increase to reduce API load
SCAN_INTERVAL_SECONDS=300

# ============================================================================
# DATABASE
# ============================================================================

# SQLite database path
# Default: data/bot.db
DATABASE_PATH=data/bot.db

# ============================================================================
# LOGGING
# ============================================================================

# Log level: error, warn, info, debug
# Default: info
LOG_LEVEL=info

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable Clanker scraper (true/false)
# Default: true
ENABLE_CLANKER=true

# Enable Bankr scraper (true/false)
# Default: true
ENABLE_BANKR=true
