# Base Memecoin Detector Bot Configuration

# API Endpoints
CLANKER_API_URL=https://api.clanker.world
BANKR_API_URL=https://api.bankr.world
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YrNJqkWLH6X0BLmTR9Z0f5Dz9Qx8K2mP

# Scoring Thresholds (lowered for testing)
SCORING_THRESHOLD=50
PREMIUM_SCORE_THRESHOLD=80

# Telegram Configuration (test bot - no real alerts during dev)
TELEGRAM_BOT_TOKEN=test_token_placeholder
TELEGRAM_CHAT_ID=-1001234567890

# Scan Settings
SCAN_INTERVAL_SECONDS=60

# Database
DATABASE_PATH=data/bot.db

# Logging
LOG_LEVEL=debug

# Feature Flags
ENABLE_CLANKER=true
ENABLE_BANKR=true

# Block Explorer
BLOCK_EXPLORER_URL=https://basescan.org
