{
  "name": "base-memecoin-detector",
  "version": "0.1.0",
  "description": "Automated memecoin detection and scoring bot for Base chain",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
