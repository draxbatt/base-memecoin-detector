{
  "name": "base-memecoin-detector",
  "version": "0.1.0",
  "description": "Automated memecoin detection and alert system for Base chain",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --loader ts-node/esm src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "stats": "node --loader ts-node/esm src/cli/stats.ts",
    "export:alerts": "node --loader ts-node/esm src/cli/export.ts",
    "cleanup": "node --loader ts-node/esm src/cli/cleanup.ts"
  },
  "keywords": [
    "memecoin",
    "base",
    "ethereum",
    "l2",
    "detection",
    "sniping",
    "telegram",
    "bot"
  ],
  "author": "draxbatt",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "ethers": "^6.9.0",
    "node-cron": "^3.0.2",
    "node-telegram-bot-api": "^0.63.0",
    "sqlite3": "^5.1.6",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
